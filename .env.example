# Copier ce fichier en .env puis remplacer toutes les valeurs CHANGE_ME
# Le mot de passe de POSTGRES_PASSWORD doit être le même que dans DATABASE_URL

POSTGRES_USER=complianceforge
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=complianceforge

DATABASE_URL=postgresql+psycopg2://complianceforge:CHANGE_ME@db:5432/complianceforge
SECRET_KEY=CHANGE_ME
ENVIRONMENT=development
